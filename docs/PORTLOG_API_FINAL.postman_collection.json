					"name": "Iniciar sesión",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login responde con éxito', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
									"try {",
									"  const data = pm.response.json();",
									"  const token = data.token || data.access_token || (data.usuario && data.usuario.token);",
									"  if (token) { pm.collectionVariables.set('token', token); console.log('Token guardado en variable token.'); }",
									"  else { console.log('No se detectó el campo token; copia el token de la respuesta y guárdalo en la variable token.'); }",
									"} catch (e) { console.log('La respuesta no contiene JSON válido.'); }"
								]
							}
						}
